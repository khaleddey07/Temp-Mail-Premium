# ============================================================
# TempMail Premium — Variables d'environnement
# ============================================================
# Copiez ce fichier en « .env » et adaptez les valeurs.
# Sur Vercel : Dashboard → votre projet → Settings → Environment Variables.

# ─── MODE LOCAL (par défaut) ─────────────────────────────────
# Base SQLite fichier (aucun service externe requis)
DATABASE_URL=file:./db/custom.db

# ─── MODE TURSO (production gratuite sur Vercel) ─────────────
# Créez une base gratuite sur https://turso.tech puis décommentez :
# TURSO_DATABASE_URL=libsql://votre-base-votre-user.turso.io
# TURSO_AUTH_TOKEN=votre-token-secret
#
# ⚠️ Si TURSO_DATABASE_URL est défini, il prend le pas sur DATABASE_URL.
# Sur Vercel, laissez aussi DATABASE_URL pointé vers la même base
# (le prisma schema l'exige, il n'est pas utilisé à l'exécution avec Turso).
